# Copy to .env.local and fill in. Leaving TURSO_* empty makes lib/db.ts fall
# back to a local ./dev.db file, which is all you need to run the site.
#
# NEVER paste another project's values here — see "Landmines" in the README.

# Session signing secret. Any long random string.
AUTH_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Turso. Leave empty for local development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Prisma CLI target for db push / migrate. Keep as the local file.
DATABASE_URL=file:./dev.db

# Resend — transactional and campaign email.
RESEND_API_KEY=
RESEND_FROM=
SUPPORT_EMAIL=
RESEND_WEBHOOK_SECRET=

# Anthropic — powers the site chat agent. Without it the widget degrades to a
# "write to us" fallback rather than breaking.
ANTHROPIC_API_KEY=

# Vercel Blob — image uploads in the email composer.
BLOB_READ_WRITE_TOKEN=

# Seed credentials (bun run seed). Local defaults are admin@valcatech.com /
# admin123; set these before seeding anything that is not a throwaway database.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
